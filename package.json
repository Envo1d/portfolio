{
  "name": "envo1d-portfolio",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm demos:build && pnpm --filter @envo1d/portfolio dev",
    "demos:build": "pnpm --filter @envo1d/react-demo build && pnpm --filter @envo1d/vue-demo build && node scripts/copy-demos.mjs",
    "build": "pnpm demos:build && pnpm --filter @envo1d/portfolio build",
    "generate": "pnpm demos:build && pnpm --filter @envo1d/portfolio generate",
    "preview": "pnpm --filter @envo1d/portfolio preview",
    "typecheck": "pnpm -r typecheck"
  }
}
